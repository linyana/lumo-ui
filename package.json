{
	"name": "lumo-ui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.11",
	"scripts": {
		"dev": "bun run llms:build && vite",
		"build": "bun run registry:build && bun run llms:build && vite build",
		"build:check": "bun run check && bun run build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"check": "oxfmt --check . && oxlint . && tsc --noEmit && bun scripts/check-registry.ts",
		"check:fix": "oxfmt . && oxlint --fix . && tsc --noEmit && bun scripts/check-registry.ts --fix",
		"registry:check": "shadcn registry validate registry.json",
		"registry:build": "shadcn build registry.json -o public/r",
		"registry:sync": "bun scripts/check-registry.ts --fix",
		"llms:build": "bun scripts/llms.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"clsx": "^2.1.1",
		"diff": "^9.0.0",
		"lucide-react": "^1.64.0",
		"motion": "^14.8.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.0",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.90.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"wrangler": "^4.156.0"
	}
}
