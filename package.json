{
	"name": "lumo-ui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.11",
	"scripts": {
		"dev": "vite",
		"build": "bun run check && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"check": "oxfmt --check . && oxlint . && tsc --noEmit && bun scripts/check-registry.ts",
		"check:fix": "oxfmt . && oxlint --fix . && tsc --noEmit && bun scripts/check-registry.ts --fix",
		"registry:check": "shadcn registry validate registry.json",
		"registry:sync": "bun scripts/check-registry.ts --fix"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"clsx": "^2.1.1",
		"diff": "^9.0.0",
		"lucide-react": "^1.58.0",
		"motion": "^14.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"shadcn": "^4.21.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	}
}
